# Server configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=gitscope_db

# Database Configuration Fallback (SQLite)
# Used automatically if MySQL is unavailable, or if DB_DIALECT is set to sqlite
DB_SQLITE_PATH=./database.sqlite

# GitHub API Configuration
# Highly recommended to prevent API rate limiting (60/hr unauthenticated vs 5000/hr authenticated)
GITHUB_TOKEN=your_github_personal_access_token_here
